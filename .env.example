PORT=4000
CORS_ORIGINS=http://localhost:5173,https://your-frontend-domain.vercel.app

# SMTP details from your email provider (keep these server-side only).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=Website Notifications <no-reply@example.com>

# Destination inbox for non-sensitive form notifications.
SUBMISSION_EMAIL=you@example.com
